 "comment": "瓜子漫画 guazimanhua.com。发现页按“分组 → 标签 → 卡片”三层渲染：题材 23 个、地区 5 个、受众 2 个、进度 2 个、排序 4 个，全部来自 /category.php 的筛选矩阵。详情页服务端渲染全部章节，正文取 img.reading-image。列表、目录、正文都用正则或绝对地址处理，避免相对路径导致点击转圈。",
 "enabled": true,
 "enabledExplore": true,
 "headers": {
  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "Referer": "https://www.guazimanhua.com/",
  "Accept-Language": "zh-CN,zh;q=0.9"
 },
 "lib": "fn reverseList(v) {\n  let out = []\n  for x, i in v {\n    push(out, v[len(v) - 1 - i])\n  }\n  return out\n}\n\nfn cardsFrom(html, base) {\n  let out = []\n  let hrefs = matchAll(html, '<h3><a href=\"([^\"]+)\"', 1)\n  let names = matchAll(html, '<h3><a href=\"[^\"]+\">([^<]+)</a></h3>', 1)\n  let covers = matchAll(html, 'class=\"cover\"[^>]*src=\"([^\"]+)\"', 1)\n  let metas = matchAll(html, '<div class=\"meta\">([^<]+)</div>', 1)\n  let n = len(hrefs)\n  if len(names) < n {\n    n = len(names)\n  }\n  for h, i in hrefs {\n    if i < n {\n      let u = absUrl(h, base)\n      if contains(u, 'comic.php') {\n        let c = ''\n        if i < len(covers) {\n          c = absUrl(covers[i], base)\n        }\n        let m = ''\n        let a = ''\n        if i < len(metas) {\n          m = metas[i]\n          let parts = split(m, '·')\n          if len(parts) > 0 {\n            a = trim(parts[0])\n            let rest = []\n            for x, i2 in parts {\n              if i2 > 0 { rest = push(rest, trim(x)) }\n            }\n            m = join(rest, ' · ')\n          }\n        }\n        push(out, {name: names[i], bookUrl: u, coverUrl: c, author: a, kind: m})\n      }\n    }\n  }\n  return out\n}\n\nfn chaptersFrom(html, base) {\n  let out = []\n  let block = match(html, 'data-chapter-list([\\s\\S]*?)</div>', 1)\n  if block == '' {\n    return []\n  }\n  let hrefs = matchAll(block, 'href=\"([^\"]+)\"', 1)\n  let names = matchAll(block, '>([^<]+)</a>', 1)\n  let n = len(hrefs)\n  if len(names) < n {\n    n = len(names)\n  }\n  for h, i in hrefs {\n    if i < n {\n      let u = absUrl(h, base)\n      if contains(u, 'chapter.php') {\n        push(out, {name: names[i], url: u})\n      }\n    }\n  }\n  return reverseList(out)\n}\n\nfn pageImages(html, base) {\n  let a = matchAll(html, 'class=\"reading-image[^\"]*\"[^>]*src=\"([^\"]+)\"', 1)\n  let out = []\n  for u in a {\n    push(out, absUrl(u, base))\n  }\n  return out\n}",
 "search": {
  "url": "{{source.url}}/category.php?keyword={{urlencode(default(trim(key), '恋爱'))}}&page={{page}}",
  "list": "= cardsFrom(body, source.url)",
