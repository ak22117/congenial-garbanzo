 "detail": {
  "let": {
   "bid": "= match(book.bookUrl, 'book/(\\d+)', 1)"
  },
  "fields": {
   "name": "h1.detail__header-detail__title@text",
   "author": "a.detail__header-detail__author-link@ownText",
   "intro": "p.detail__summary__content@text",
   "kind": "= join(selAll('a.detail__header-detail__category@text'), ',')",
   "status": "= match(sel('p.detail__header-detail__line:last@text'), '^(连载|完本)')",
   "lastChapter": "a.chapter-link.0@text##^\\s*最新章节\\s*",
   "updateTime": "span.chapter-time.0@text",
   "wordCount": "= sel('.novelbook__honorinfo .item:eq(1) .value@text') ? sel('.novelbook__honorinfo .item:eq(1) .value@text') + '万字' : ''",
   "coverUrl": "= bid ? 'https://bookcover.yuewen.com/qdbimg/349573/' + bid + '/180' : ''"
  },
  "keep": {
   "bid": "= bid"
  }
 },
 "toc": {
  "script": "qdToc"
 },
 "content": {
  "let": {
   "cid": "= match(chapter.url, '/(\\d+)/$', 1)"
  },
  "text": "= default(join(selAll('main#c-' + cid + ' p@text'), '\\n'), sel('main#c-' + cid + '@text'))"
 },
 "_stripped": 336
}