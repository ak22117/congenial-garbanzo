{
 "sourceFormat": "native",
 "version": 1,
 "name": "发现起点",
 "url": "https://m.qidian.com",
 "group": "渡",
 "comment": "起点 · 轻页原生（发现/榜单）· v2（2026-11-14 修复 csrf）\n\n【本次修复】原版靠顶层 cache 抓 /category/ 的 Set-Cookie 取 _csrfToken；起点现已不再下发该 cookie，榜单接口在 token 缺失时返回 {\"code\":1,\"msg\":\"失败\"} → 宿主显示「发现接口返回失败：失败」。\n现改为 explore 脚本每次自造 uuid，同时放进 URL 参数与 Cookie 头。实测 2026-11-14：月票榜/畅销榜/阅读榜等 majax/rank/* 均 code:0、20 条/页、可翻页。\n【其它】搜索/详情/目录（wxapp categoryV2）/正文逻辑未改。未登录仍只能看试读，VIP 章节内容有限。",
 "type": "text",
 "js": "function qdToc(ctx) {\n  var bid = native.match(ctx.book.bookUrl, 'book/(\\\\d+)', 1);\n  if (!bid) throw new Error('无法从书籍地址取得书号：' + ctx.book.bookUrl);\n  var url = 'https://wxapp.qidian.com/api/book/categoryV2?bookId=' + bid;\n  var res = http.get(url);\n  if (!res.ok) throw new Error('目录接口请求失败：HTTP ' + res.status);\n  var payload = res.json();\n  if (!payload || payload.code !== 0 || !payload.data || !payload.data.vs) throw new Error('目录接口返回异常');\n  var chapters = [];\n  payload.data.vs.forEach(function (volume) {\n    if (volume.vN) chapters.push({ title: volume.vN, isVolume: true });\n    (volume.cs || []).forEach(function (item) {\n      chapters.push({\n        title: item.cN,\n        url: 'https://m.qidian.com/chapter/' + bid + '/' + item.id + '/',\n        isVip: item.sS === 0,\n        tag: (item.uT || '') + (item.cnt ? ' · ' + item.cnt + '字' : '')\n      });\n    });\n  });\n  if (!chapters.length) throw new Error('目录为空，站点可能调整了目录接口');\n  return chapters;\n}\n\n// 榜单（2026-11-14 修复）：起点已不再通过 /category/ 下发 _csrfToken，\n// 而 majax/rank/* 要求「URL 参数与 Cookie 里的 _csrfToken 相同」——\n// 缺 token 时服务端直接回 {\"code\":1,\"msg\":\"失败\"}，宿主就显示「发现接口返回失败：失败」。\n// 做法：每次请求自造一个 uuid，同时放进参数与 Cookie 头（实测 code:0，20 条/页，可翻页）。\nfunction qdRank(ctx) {\n  var t = uuid();\n  var url = String(ctx.url || '');\n  if (url.indexOf('_csrfToken=') >= 0) {\n    url = url.replace(/_csrfToken=[^&]*/, '_csrfToken=' + t);\n  } else {\n    url += (url.indexOf('?') >= 0 ? '&' : '?') + '_csrfToken=' + t;\n  }\n  var res = http.get(url, { headers: {\n    'User-Agent': 'Mozilla/5.0 (Linux; U; Android 13; zh-cn; MI 11) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120 Mobile Safari/537.36',\n    'Referer': 'https://m.qidian.com/',\n    'Cookie': '_csrfToken=' + t,\n    'Accept': 'application/json, text/plain, */*'\n  } });\n  if (!res.ok) { throw new Error('榜单请求失败：HTTP ' + res.status); }\n  var j = res.json();\n  if (!j || Number(j.code) !== 0) { throw new Error('榜单接口返回：' + ((j && j.msg) || '空')); }\n  var list = ((j.data || {}).records) || [];\n  var out = [];\n  for (var i = 0; i < list.length; i++) {\n    var it = list[i] || {};\n    var kind = [];\n    if (it.cat) { kind.push(String(it.cat)); }\n    if (it.subCat) { kind.push(String(it.subCat)); }\n    out.push({\n      name: String(it.bName || ''),\n      author: String(it.bAuth || ''),\n      kind: kind.join(','),\n      intro: String(it.desc || ''),\n      wordCount: it.cnt == null ? '' : String(it.cnt),\n      lastChapter: it.lastVUCname == null ? '' : String(it.lastVUCname),\n      coverUrl: 'https://bookcover.yuewen.com/qdbimg/349573/' + it.bid,\n      bookUrl: 'https://m.qidian.com/book/' + it.bid + '/'\n    });\n  }\n  if (!out.length) {\n    if (Number(ctx.page || 1) > 1) { return []; }\n    throw new Error('榜单无数据');\n  }\n  return out;\n}\n",
 "scriptLimits": {
  "requests": 5
 },
 "search": {
  "url": "{{source.url}}/soushu/{{urlencode(key)}}.html?pageNum={{page}}",
  "list": "div.y-list__item",
  "fields": {
   "name": "h2[class^=_searchBookName]@text",
   "author": "p[class^=_searchBookAuthor]@text",
   "intro": "p[class^=_searchBookDesc]@text",
   "kind": "= join(slice(selAll('div[class^=_tags] p@text'), 0, 2), ',')",
   "wordCount": "= sel('div[class^=_tags] p.2@text')",
   "coverUrl": "= default(absUrl(sel('img@data-src'), baseUrl), match(sel('a@href'), 'chapter/(\\d+)/', 1) ? 'https://bookcover.yuewen.com/qdbimg/349573/' + match(sel('a@href'), 'chapter/(\\d+)/', 1) + '/180' : '')",
   "bookUrl": "= match(sel('a@href'), 'chapter/(\\d+)/', 1) ? 'https://m.qidian.com/book/' + match(sel('a@href'), 'chapter/(\\d+)/', 1) + '/' : ''"
  }
 },
