  "list": ".sitebox dl",
  "fields": {
   "name": "h3 a@text",
   "bookUrl": "h3 a@href",
   "coverUrl": "dt img@src",
   "intro": "dd.book_des@text",
   "author": "dd.book_other span@text",
   "lastChapter": "dd.book_other a@text",
   "updateTime": "span.uptime@text"
  }
 },
 "search": {
  "url": "{{source.url}}/modules/article/search.php?searchkey={{urlencode(key)}}",
  "fail": "= key == '' ? '请输入书名或作者名再搜索' : ''",
  "list": ".toplist li",
  "fields": {
   "name": ".s1@text",
   "bookUrl": ".s1 a@href",
   "author": ".s3@text",
   "kind": "",
   "lastChapter": ".s2@text",
   "wordCount": ".s4@text",
   "status": ".s5@text",
   "updateTime": ".s6@text",
   "coverUrl": "= bqCover(sel(\".s1 a@href\"), source.url)"
  }
 },
 "detail": {
  "fields": {
   "name": "#info h1@text",
   "author": ".options span:eq(0)@text",
   "coverUrl": "meta[property=\"og:image\"]@content",
   "intro": ".bookinfo_intro@text##^《[^》]*》简介：|《[^》]*》是作者[\\s\\S]*|您要是觉得[\\s\\S]*",
   "kind": ".title a:eq(1)@text##小说",
   "lastChapter": ".update a@text",
   "updateTime": ".options span:eq(1)@text",
   "status": "meta[property=\"og:novel:status\"]@content"
  }
 },
 "toc": {
  "list": ".book_list li a",
  "fields": {
   "title": "@text",
   "url": "@href"
  }
 },
 "content": {
  "text": "#htmlContent@html"
 }
