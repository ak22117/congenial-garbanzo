 "detail": {
  "url": "= api + '/comic/info/?comic_id=' + cidOf(book.bookUrl)",
  "fail": "= data.code == '200' ? '' : default(data.message, '详情接口异常')",
  "keep": {
   "cid": "= cidOf(book.bookUrl)"
  },
  "fields": {
   "name": "= data.data.title",
   "author": "= default(book.author, '')",
   "coverUrl": "= data.data.cover ? replace(data.data.cover, '^http:', 'https:') + '!cover-400' : ''",
   "intro": "= data.data.content",
   "kind": "= join(compact([themeList(data.data.theme_id), data.data.chapter_number ? data.data.chapter_number + '话' : '']), ' ')",
   "status": "= finishName(data.data.finish)",
   "lastChapter": "= default(data.data.chapter_title, '')",
   "updateTime": "= data.data.chapter_start_time ? formatDate(num(data.data.chapter_start_time) * 1000, 'yyyy-MM-dd') : ''"
  }
 },
 "toc": {
  "url": "= api + '/chapter/v1/?comic_id=' + cidOf(book.bookUrl)",
  "fail": "= data.code == '200' ? '' : default(data.message, '目录接口异常')",
  "list": "$.data[*]",
  "fields": {
   "title": "$.title",
   "url": "= api + '/chapter/content/?comic_id=' + cidOf(book.bookUrl) + '&chapter_id=' + $.chapter_id"
  }
 },
 "content": {
  "images": "= map(default(data.data, []), x => replace(x.image, '^http:', 'https:'))",
  "fail": "= len(default(data.data, [])) == 0 ? '本话暂无可读内容（未发布 / 已下架）' : ''"
 }
