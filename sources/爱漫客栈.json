 "lib": "fn cidOf(u) {\n  return replace(u, '[^0-9]', '')\n}\nfn themeName(id) {\n  let names = ['', '霸总', '修真', '恋爱', '校园', '冒险', '搞笑', '生活', '热血', '架空', '后宫', '成人', '玄幻', '悬疑', '恐怖', '灵异', '动作', '科幻', '战争', '古风', '穿越', '竞技', '体育', '励志', '同人', '历史', '真人']\n  let i = int(id, 0)\n  if i > 0 && i < len(names) {\n    return names[i]\n  }\n  return ''\n}\nfn themeList(ids) {\n  let out = []\n  for id in split(ids, ',') {\n    let n = themeName(id)\n    if len(n) > 0 {\n      out = push(out, n)\n    }\n  }\n  return join(out, ' ')\n}\nfn finishName(v) {\n  if v == '2' {\n    return '已完结'\n  }\n  if v == '1' {\n    return '连载中'\n  }\n  return ''\n}\nfn audienceName(v) {\n  if v == '1' {\n    return '少年'\n  }\n  if v == '2' {\n    return '少女'\n  }\n  if v == '3' {\n    return '青年'\n  }\n  if v == '4' {\n    return '少儿'\n  }\n  return ''\n}\nfn urlTags(u) {\n  let out = []\n  let t = match(u, 'theme_id=([0-9]+)', 1)\n  if len(t) > 0 {\n    out = push(out, themeName(t))\n  }\n  let f = match(u, 'finish=([0-9]+)', 1)\n  if len(f) > 0 {\n    out = push(out, finishName(f))\n  }\n  let g = match(u, 'audience=([0-9]+)', 1)\n  if len(g) > 0 {\n    out = push(out, audienceName(g))\n  }\n  if contains(u, 'is_free=1') {\n    out = push(out, '免费')\n  }\n  if contains(u, 'is_vip=1') {\n    out = push(out, 'VIP')\n  }\n  if contains(u, 'is_fee=1') {\n    out = push(out, '付费')\n  }\n  if contains(u, 'copyright=1') {\n    out = push(out, '独家')\n  }\n  if contains(u, 'copyright=2') {\n    out = push(out, '合作')\n  }\n  if contains(u, 'update') {\n    out = push(out, '最近更新')\n  }\n  return out\n}\nfn tags(count, rank, author, url) {\n  let out = []\n  let c = replace(count, '[:：]\\\\s*', '')\n  if len(c) > 0 {\n    out = push(out, c)\n  }\n  if len(rank) > 0 {\n    out = push(out, '第' + rank + '名')\n  }\n  let a = replaceText(author, '作者：', '')\n  if len(a) > 0 {\n    out = push(out, a)\n  }\n  if len(url) > 0 {\n    out = concat(out, urlTags(url))\n  }\n  return join(out, ' ')\n}",
