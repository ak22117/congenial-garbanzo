  "list": ".rec_rullist ul",
  "fields": {
   "name": "a:eq(1)@text",
   "author": "li:eq(4)@text",
   "kind": "a:eq(0)@text##小说",
   "lastChapter": "a:eq(2)@text",
   "bookUrl": "a:eq(1)@href",
   "wordCount": "li:eq(5)@text",
   "updateTime": "li:eq(6)@text"
  }
 },
 "search": {
  "url": "{{vars.site}}/search.html?q={{urlencode(key)}}&p={{page}}",
  "list": ".list-group-item",
  "fields": {
   "name": "a:eq(0)@text##^\\d+\\.\\s*",
   "author": "a:eq(1)@text",
   "bookUrl": "a:eq(0)@href",
   "intro": "p.content-txt@text",
   "kind": ".text-muted:eq(-1) a@text##\\#",
   "updateTime": ".timedesc@text##.+时间.",
   "status": "h5 small@text##\\[|\\]"
  }
 },
 "detail": {
  "fields": {
   "name": ".novel_title@text",
   "author": ".novel_info a:eq(0)@text",
   "kind": ".novel_info p:eq(1)@text##.+：",
   "coverUrl": "meta[property=\"og:image\"]@content||.pic img@data-src||.pic img@src",
   "intro": ".jianjie p@html",
   "lastChapter": ".novel_info p:eq(-1) a@text",
   "wordCount": "= tyWord(info)",
   "status": ".novel_info p:eq(4)@text##.+：",
   "tocUrl": "= source.url + '/other/chapters/id/' + str(match(book.bookUrl, '/novel/([0-9]+)', 1)) + '.html'"
  },
  "let": {
   "info": ".novel_info@text"
  }
 },
 "toc": {
  "list": ".mulu_list li a",
  "fields": {
   "title": "text",
   "url": "href"
  },
  "url": "= source.url + '/other/chapters/id/' + str(match(book.bookUrl, '/novel/([0-9]+)', 1)) + '.html'"
 },
 "content": {
  "text": ".read-content@html"
 },
 "lib": "// 从详情信息段里抓「N万字」（站点 p 顺序会变，不写死行号）\nfn tyWord(s) {\n  let m = match(str(s), '([0-9.]+)\\\\u4e07', 1)\n  if (m == '') { return '' }\n  return m + '万字'\n}\n"
}