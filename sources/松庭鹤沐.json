  "list": "$.rows[*]",
  "fields": {
   "name": "= trim(replace($.resourceName, '（.*', ''))",
   "author": "$.author",
   "bookUrl": "= source.url + '/qbread/api/novel/intro-info?bookid=' + $.resourceID",
   "coverUrl": "$.picurl",
   "intro": "$.summary",
   "kind": "= $.subject",
   "wordCount": "= round(num($.contentsize) / 10000, 1) + '万字'",
   "status": "= $.isfinish ? '已完结' : '连载中'",
   "updateTime": "= formatDate(num($.lastUpdatetime) * 1000, 'yyyy-MM-dd')"
  },
  "headers": {
   "User-Agent": "Mozilla/5.0 (Linux; Android 10; MI 8 Build/QKQ1.190828.002; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/83.0.4103.101 Mobile Safari/537.36",
   "Referer": "https://bookshelf.html5.qq.com/qbread"
  }
 },
 "search": {
  "url": "https://newopensearch.reader.qq.com/wechat?keyword={{urlencode(key)}}&start={{(page-1)*20}}&end={{page*20-1}}",
  "list": "$.booklist[*]",
  "fields": {
   "name": "$.title",
   "author": "$.author",
   "bookUrl": "= source.url + '/qbread/api/novel/intro-info?bookid=' + (1100000000 + int($.bid))",
   "coverUrl": "= 'https://wfqqreader-1252317822.image.myqcloud.com/cover/' + int(match($.bid, '(\\\\d{3})$', 1)) + '/' + $.bid + '/b_' + $.bid + '.jpg'",
   "intro": "$.intro",
   "kind": "= join(map(split($.categoryInfoV4, ','), x => match(x, ':(.*?):.*$', 1)), ' ')",
   "wordCount": "= round(num($.totalWords) / 10000, 1) + '万字'",
   "lastChapter": "$.updateInfo",
   "status": "= test($.updateInfo, '完结') ? '已完结' : '连载中'"
  },
  "headers": {
   "User-Agent": "Mozilla/5.0 (Linux; Android 10; MI 8 Build/QKQ1.190828.002; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/83.0.4103.101 Mobile Safari/537.36",
   "Referer": "https://bookshelf.html5.qq.com/qbread"
  }
 },
 "detail": {
  "let": {
   "b": "= data.data.bookInfo"
  },
  "fail": "= data && data.ret != 0 ? 'QQ阅读没有这本书的可读版本（搜索结果可能来自其它书库）' : ''",
  "fields": {
   "name": "= b.resourceName",
   "author": "= b.author",
   "coverUrl": "= b.picurl",
   "intro": "= (b.tag ? '🏷️ ' + replace(b.tag, '\\|', '、') + '\\n\\n' : '') + b.summary",
   "kind": "= b.userscore + '分 ' + b.subject + ' ' + (b.isfinish ? '已完结' : '连载中')",
   "wordCount": "= round(num(b.contentsize) / 10000, 1) + '万字'",
   "status": "= b.isfinish ? '已完结' : '连载中'",
   "lastChapter": "= b.lastSerialname + ' • ' + formatDate(num(b.lastUpdatetime) * 1000, 'yyyy-MM-dd')",
   "updateTime": "= formatDate(num(b.lastUpdatetime) * 1000, 'yyyy-MM-dd')",
   "tocUrl": "= source.url + '/qbread/api/book/all-chapter?bookId=' + b.resourceID"
  },
  "keep": {
   "bookId": "= b.resourceID"
  },
  "headers": {
   "User-Agent": "Mozilla/5.0 (Linux; Android 10; MI 8 Build/QKQ1.190828.002; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/83.0.4103.101 Mobile Safari/537.36",
   "Referer": "https://bookshelf.html5.qq.com/qbread"
  }
 },
 "toc": {
  "retry": 1,
  "url": "= default(book.tocUrl, source.url + '/qbread/api/book/all-chapter?bookId=' + default(book.vars.bookId, match(book.bookUrl, 'bookid=(\\d+)', 1), match(book.tocUrl, 'bookId=(\\d+)', 1)))",
  "list": "$.rows[*]",
  "fail": "= data == null ? '目录接口没有返回内容' : data.ret != 0 ? '目录接口返回 ' + data.ret + '：' + data.errMsg : ''",
  "fields": {
   "title": "$.serialName",
   "url": "= 'https://novel.html5.qq.com/be-api/content/ads-read?bookId=' + default(book.vars.bookId, match(book.bookUrl, 'bookid=(\\d+)', 1), match(book.tocUrl, 'bookId=(\\d+)', 1)) + '&seq=' + $.serialID",
   "isVip": "= $.isFree != true",
   "isPay": "= $.isFree != true",
   "tag": "= $.isFree ? '' : '付费'"
  },
  "headers": {
   "User-Agent": "Mozilla/5.0 (Linux; Android 10; MI 8 Build/QKQ1.190828.002; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/83.0.4103.101 Mobile Safari/537.36",
   "Referer": "https://bookshelf.html5.qq.com/qbread"
  }
 },
 "content": {
  "retry": 1,
  "url": "https://novel.html5.qq.com/be-api/content/ads-read",
  "method": "POST",
  "headers": {
   "User-Agent": "Mozilla/5.0 (Linux; Android 10; MI 8 Build/QKQ1.190828.002; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/83.0.4103.101 Mobile Safari/537.36",
   "Referer": "https://bookshelf.html5.qq.com/qbread",
   "Content-Type": "application/json",
   "Q-GUID": "{{vars.guid}}"
  },
  "body": "= {Scene: 'chapter', ContentAnchorBatch: [{BookID: bidOf(book.vars.bookId, chapter.url, book.bookUrl), ChapterSeqNo: [int(default(match(chapter.url, 'seq=(\\\\d+)', 1), 1))]}]}",
  "fail": "= data == null ? '正文接口没有返回内容' : data.ret != 0 ? '正文接口返回 ' + data.ret + '：' + data.errMsg : trim(join(default(get(get(data.data, 'Content'), 0).Content, []), '')) ? '' : '这一章没有取到正文：可能已下架，或接口改了参数'",
  "text": "= join(default(get(get(data.data, 'Content'), 0).Content, []), '\\n')",
  "replace": [
   {
    "pattern": "\\r\\n[ \\t]*",
    "with": "\n",
    "flags": "g"
   }
  ]
 },
 "vars": [
  {
   "key": "guid",
   "label": "Q-GUID（正文接口用，失效时换一个）",
   "default": "4aa27c7cf2d9aca3359656ea186488cb"
  }
 ],
 "lib": "fn bidOf(v, cu, bu) { return default(v, match(str(cu), 'bookId=(\\\\d+)', 1), match(str(bu), 'bookid=(\\\\d+)', 1)) }"
}