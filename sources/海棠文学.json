 "lib": "fn clean(html) {\n  let t = stripHtml(html)\n  let out = []\n  for line in split(t, '\\n') {\n    let s = trim(line)\n    if (s != '') { push(out, s) }\n  }\n  return join(out, '\\n')\n}\n",
