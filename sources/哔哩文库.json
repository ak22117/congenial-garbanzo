{
 "sourceFormat": "native",
 "version": 1,
 "name": "哔哩文库",
 "url": "https://www.biliwenku.com",
 "headers": {
  "Referer": "https://www.biliwenku.com/"
 },
 "search": {
  "url": "/search.html?keyword={{urlencode(key)}}",
  "list": ".search-result-item",
  "fields": {
   "name": ".rank-modules-works-item-title@text",
   "bookUrl": ".rank-modules-works-item-title@href",
   "coverUrl": ".rank-modules-works-item-cover img@src",
   "intro": ".rank-modules-works-item-desc@text",
   "lastChapter": ".rank-modules-works-item-chapter-name a@text",
   "author": ".rank-modules-works-item-author@text##\\s*·[\\s\\S]*$##"
  }
 },
 "detail": {
  "fields": {
   "name": "h1.book-title@text",
   "author": ".book-meta-item a.value@text",
   "coverUrl": ".book-info--coverImage-cover img@src",
   "intro": "#introText@text",
   "lastChapter": "#latestChapter@text",
   "updateTime": "#updateTime@text"
  }
 },
 "toc": {
  "list": ".chapter-list-container ol li",
  "fields": {
   "title": ".chapter-title@text##^分卷[：:]##",
   "url": "a@href",
   "isVolume": "= len(sel('a@href')) == 0"
  }
 },
 "content": {
  "let": {
   "raw": "#TextContent@html"
  },
  "text": "= blBody(raw)"
 },
