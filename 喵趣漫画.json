  "list": "$[*]",
  "fields": {
   "name": "$.manhuaming",
   "bookUrl": "= 'miaoqu://' + $.manhuaid",
   "author": "= default($.zuozhe, $.manhuazuozhe, '')",
   "kind": "= trim($.fenlei)",
   "coverUrl": "= $.fengmiantu ? 'https://tong.zqykfz.cn/' + $.fengmiantu : ''",
   "intro": "= stripHtml($.description)",
   "status": "$.zhuangtai",
   "lastChapter": "$.newchapter",
   "updateTime": "$.updatedtime"
  }
 },
 "detail": {
  "url": "= ''",
  "fields": {
   "name": "= book.name",
   "author": "= book.author",
   "kind": "= book.kind",
   "intro": "= book.intro",
   "coverUrl": "= book.coverUrl",
   "status": "= book.status",
   "lastChapter": "= book.lastChapter",
   "updateTime": "= book.updateTime"
  },
  "keep": {
   "mid": "= match(book.bookUrl, '(\\d+)', 1)"
  }
 },
 "toc": {
  "retry": 2,
  "headers": {
   "Accept": "application/json"
  },
  "url": "= 'http://apitong.zqykfz.cn/miaoqu45/' + floor(num(default(book.vars.mid, match(book.bookUrl, '(\\d+)', 1))) / 1000) + '/' + default(book.vars.mid, match(book.bookUrl, '(\\d+)', 1)) + '/info.json'",
  "let": {
   "b64": "= trim(body)",
   "hx": "= join(map(range(int(ceil(len(b64) / 80000))), i => bytesHex(base64Bytes(slice(b64, i * 80000, min((i + 1) * 80000, len(b64)))))), '')",
   "plain": "= join(map(range(int(ceil((len(hx) / 2 - 28) / 60000))), j => fromBytes(decrypt('AES/CTR/NoPadding', hexBytes(slice(hx, 24 + j * 120000, min(24 + (j + 1) * 120000, len(hx) - 32))), '9i92uhn864ol1445', hexBytes(slice(hx, 0, 24) + toHex(2 + j * 3750, 8))))), '')",
   "d": "= json(plain)"
  },
  "list": "= d.chapter",
  "fields": {
   "title": "$.chaptername",
   "url": "= 'https://tong.zqykfz.cn/tu/' + floor(num($.mangaid) / 1000) + '/' + $.mangaid + '/' + $.chapterid + '/1.jpeg?n=' + $.geshu",
   "tag": "= $.createdtime"
  }
 },
 "content": {
  "url": "= ''",
  "let": {
   "np": "= int(match(chapter.url, '[?&]n=(\\d+)$', 1))"
  },
  "images": "= map(range(np), p => replaceText(replace(chapter.url, '\\?n=\\d+$', ''), '/1.jpeg', '/' + str(p + 1) + '.jpeg'))",
  "mediaHeaders": {
   "User-Agent": "MangaApp/1.0"
  },
  "imageDecode": {
   "script": "fixMiaoqu",
   "processPlainImages": true
  }
 }
