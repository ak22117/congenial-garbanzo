    "let": {
      "sessionCookie": "= default(cookie('https://fanqienovel.com/', 'sessionid'), vars.token)",
      "tab": "= vars.mode == '小说模式' && vars.channel == '出版' ? '出版' : replaceText(vars.mode, '模式', '')",
      "sourceType": "= vars.channel == '男频' ? '男频' : '女频'",
      "tabType": "= lookup({'小说模式': '3', '听书模式': '2', '漫画模式': '8', '短剧模式': '11', '短篇模式': '3', '漫剧模式': '19'}, vars.mode, '3')",
      "shortParam": "= vars.mode == '短篇模式' ? '&short=1' : ''"
    },
    "actions": [
      {
        "label": "🎚 服务器检查",
        "url": "{{vars.server}}/api/search?key=%E7%95%AA%E8%8C%84&offset=0&tab_type=3",
        "message": "= (data.code == 200 || data.code == 0) ? '✅ 服务器连接正常\\n' + vars.server : '❌ 服务器异常（code=' + str(data.code) + '）'"
      }
    ],
    "search": {
      "url": "= test(key, '^\\d{19}$') ? '' : vars.server + '/api/search?key=' + urlencode(key) + '&offset=' + str((page - 1) * 10) + '&tab_type=' + tabType + shortParam",
      "list": "= test(key, '^\\d{19}$') ? [{book_id: key, name: '番茄书籍 ' + key}] : $.data.list[*]",
      "fields": {
        "name": "= $.name",
        "author": "= $.author",
        "coverUrl": "= $.cover",
        "intro": "= replaceText(default($.intro, ''), '\\n', '')",
        "kind": "= join(compact([$.category, $.status, $.score ? $.score + '分' : '', ($.tab == '短剧' || $.tab == '漫剧') ? ($.episode_cnt || $.word_count ? default($.episode_cnt, $.word_count) + '集' : '') : '']), '\\n')",
        "wordCount": "= ($.tab == '短剧' || $.tab == '漫剧') ? (($.episode_cnt || $.word_count) ? default($.episode_cnt, $.word_count) + '集' : '') : (($.word_count || $.word_number) ? default($.word_count, $.word_number) + '字' : '')",
        "bookUrl": "{{vars.server}}/api/detail?book_id={{$.book_id}}",
        "type": "= $.book_type == 2 ? 'audio' : $.book_type == 8 ? 'comic' : ($.book_type == 11 || $.book_type == 19) ? 'video' : ''"
      }
    },
    "explore": {
      "menus": [
        {
          "title": "👤 个人中心",
          "when": "= sessionCookie"
        },
        {
          "title": "📚 我的书架",
          "url": "{{vars.server}}/api/user/bookshelf",
          "headers": {
            "Cookie": "sessionid={{sessionCookie}}"
          },
          "when": "= sessionCookie"
        },
        {
          "title": "🏠 首页推荐",
          "url": "{{vars.server}}/api/discover/home",
          "headers": {
            "Cookie": "sessionid={{sessionCookie}}"
          },
          "when": "= sessionCookie"
        },
        {
          "title": "💝 猜你喜欢",
          "url": "{{vars.server}}/api/user/recommend",
          "headers": {
            "Cookie": "sessionid={{sessionCookie}}"
          },
          "when": "= sessionCookie"
        },
        {
          "title": "🕘 阅读历史",
          "url": "{{vars.server}}/api/user/history",
          "headers": {
            "Cookie": "sessionid={{sessionCookie}}"
          },
          "when": "= sessionCookie"
        }
      ],
      "dynamicMenus": {
        "url": "{{vars.server}}/api/discover/style?tab={{urlencode(tab)}}&source_type={{urlencode(sourceType)}}",
        "list": "$.data[*]",
        "title": "$.title",
        "target": "= $.url ? replaceText(startsWith($.url, 'http') ? $.url : vars.server + $.url, '{{page}}', str(page)) : ''"
      },
      "list": "= $.data.books || $.data.items || (typeOf($.data) == 'list' ? $.data : [])",
      "fields": {
        "name": "$.book_name||$.name||$.title",
        "author": "$.author",
        "bookUrl": "{{vars.server}}/api/detail?book_id={{$.book_id}}",
        "coverUrl": "$.cover||$.thumb_url",
        "intro": "= replaceText(default($.abstract, $.intro, ''), '\\n', '')",
        "kind": "= $.status",
        "wordCount": "= ($.tab == '短剧' || $.tab == '漫剧') ? (($.episode_cnt || $.word_count || $.word_number) ? default($.episode_cnt, $.word_count, $.word_number) + '集' : '') : (($.word_count || $.word_number) ? default($.word_count, $.word_number) + '字' : '')",
        "type": "= $.tab == '听书' ? 'audio' : $.tab == '漫画' ? 'comic' : ($.tab == '短剧' || $.tab == '漫剧') ? 'video' : ''"
      }
    },
    "detail": {
      "let": {
        "d": "= data.data ?? data",
        "tags": "= join(compact(concat(tagList(d.category), tagList(d.tags), tagList(d.pure_category_tags))), '、')",
        "updated": "= (d.last_chapter_update_time ?? d.last_publish_time) ? formatDate(d.last_chapter_update_time ?? d.last_publish_time, 'yyyy-MM-dd HH:mm') : ''"
      },
      "fields": {
        "name": "= d.name",
        "author": "= d.author",
        "coverUrl": "= d.cover",
        "tocUrl": "{{vars.server}}/api/book?book_id={{d.book_id}}",
        "type": "= d.book_type == 2 ? 'audio' : d.book_type == 8 ? 'comic' : (d.book_type == 11 || d.book_type == 19) ? 'video' : 'text'",
        "kind": "= join(compact([d.category, d.status, d.score ? d.score + '分' : '', (d.book_type == 11 || d.book_type == 19) ? ((d.chapter_number || d.serial_count) ? default(d.chapter_number, d.serial_count) + '集' : '') : ((d.word_count || d.word_number) ? default(d.word_count, d.word_number) + '字' : '')]), '\\n')",
        "wordCount": "= (d.book_type == 11 || d.book_type == 19) ? ((d.chapter_number || d.serial_count) ? default(d.chapter_number, d.serial_count) + '集' : '') : ((d.word_count || d.word_number) ? default(d.word_count, d.word_number) + '字' : '')",
        "intro": "= default(d.intro, d.abstract, d.book_abstract_v2, d.video_desc, '暂无作品简介') + '\\n\\n作品信息\\n' + join(compact(['状态：' + (d.creation_status == 1 ? '完结' : '连载'), (d.word_number || d.word_count) ? '字数：' + ((d.word_number || d.word_count) >= 10000 ? str(round((d.word_number || d.word_count) / 10000, 1)) + '万字' : str(d.word_number || d.word_count) + '字') : '', d.score ? '评分：' + str(d.score) + '分' : '', d.author ? '作者：' + d.author : '', d.last_chapter_title ? '最新章节：' + d.last_chapter_title : '', updated ? '更新时间：' + updated : '', tags ? '标签：' + tags : '']), '\\n')"
      },
      "keep": {
        "bookId": "= d.book_id",
        "contentTab": "= d.book_type == 2 ? '听书' : d.book_type == 8 ? '漫画' : (d.book_type == 11 || d.book_type == 19) ? (vars.mode == '漫剧模式' ? '漫剧' : '短剧') : vars.mode == '听书模式' ? '听书' : vars.mode == '漫画模式' ? '漫画' : vars.mode == '漫剧模式' ? '漫剧' : '小说'"
      }
    },
    "toc": {
      "let": {
        "d": "= data.data ?? data"
      },
      "list": "= flatMap(default(d.volumes, []), v => concat([{volume: v.title}], v.chapters))",
      "fields": {
        "title": "= default($.volume, $.title)",
        "url": "= $.item_id ? vars.server + '/api/content?tab=' + default(book.vars.contentTab, (vars.mode == '听书模式' ? '听书' : vars.mode == '漫画模式' ? '漫画' : vars.mode == '短剧模式' ? '短剧' : vars.mode == '漫剧模式' ? '漫剧' : '小说')) + '&item_id=' + $.item_id + '&book_id=' + default(book.vars.bookId, match(book.bookUrl, 'book_id=(\\d+)', 1)) : ''",
        "isVolume": "= $.volume != null",
        "tag": "= ($.word_count ? $.word_count + '字' : '') + ($.update_time ? ' · ' + formatDate($.update_time, 'yyyy-MM-dd') : '')"
      }
    },
    "content": {
      "let": {
        "d": "= data.data ?? data",
        "itemId": "= match(chapter.url, 'item_id=([^&]+)', 1)",
        "bookId": "= default(book.vars.bookId, match(book.bookUrl, 'book_id=(\\d+)', 1))",
        "text0": "= default(d.content, '')",
        "text1": "= replace(text0, '\\[\\[IMG:(\\d+)\\]\\]', m => get(d.images, int(m[1])) ? '<img src=\"' + vars.server + '/api/media/stream?url=' + urlencode(replaceText(get(d.images, int(m[1])).url, '&amp;', '&')) + '\">' : '', 'g')",
        "firstLine": "= replace(stripHtml(slice(text1, 0, indexOf(text1 + '\\n', '\\n'))), '\\s', '', 'g')",
        "titleNorm": "= replace(stripHtml(chapter.title), '\\s', '', 'g')",
        "text2": "= (firstLine && ((titleNorm && (firstLine == titleNorm || contains(firstLine, titleNorm))) || test(firstLine, '^第[0-9零一二三四五六七八九十百千万两]+[章节回卷集]') || test(firstLine, '^(序章|楔子|序幕|番外|尾声|后记|前言|引子)'))) ? slice(text1, indexOf(text1 + '\\n', '\\n') + 1) : text1",
        "text3": "= cleanText(text2)"
      },
      "text": "= text3",
      "images": "= len(d.images) > 0 ? map(d.images, x => vars.server + '/api/comic/image?url=' + urlencode(replaceText(default(x.url, ''), '&amp;', '&')) + '&key=' + urlencode(default(d.encrypt_key, '')) + '&md5=' + urlencode(default(x.md5, ''))) : matchAll(default(d.content, ''), '<img[^>]+src=\"([^\"]+)\"', 1)",
      "fetch": {
        "toned": {
          "when": "= book.vars.custom",
          "url": "{{vars.server}}/api/content?tab=听书&item_id={{itemId}}&book_id={{bookId}}&tone_id={{book.vars.custom}}"
        }
      },
      "audio": "= toned ? (toned.data.content_proxy ? vars.server + toned.data.content_proxy : default(toned.data.content, '')) : (d.content_proxy ? vars.server + d.content_proxy : default(d.content, ''))",
      "video": "= d.content_proxy ? vars.server + d.content_proxy : (d.video.video_url_decrypt ? vars.server + d.video.video_url_decrypt : (d.video.video_url_proxy ? vars.server + d.video.video_url_proxy : default(d.content, '')))",
      "mediaError": "= '无法获取播放地址，请刷新重试；若始终失败，请更换服务器或到项目页面用网页播放器观看'",
      "comments": {
        "when": "= vars.dp != '0' || vars.cp != '0'",
        "stats": {
          "url": "{{vars.server}}/api/para_comment/stats?chapter_id={{itemId}}&book_id={{bookId}}"
        },
        "counts": "= vars.dp != '0' ? paraCounts(text3, stats.data.paras) : {}",
        "paragraphUrl": "{{vars.server}}/paragraph-comment.html?book_id={{bookId}}&item_id={{itemId}}&para_index={{para.index}}&para_text={{urlencode(para.text)}}",
        "chapterUrl": "= vars.cp != '0' ? vars.server + '/comment-viewer.html?book_id=' + bookId + '&item_id=' + itemId + '&chapter_tog=true&api_base=' + urlencode(vars.server) : ''",
        "max": 60
      }
    }
  },
  {
    "sourceFormat": "native",
    "version": 1,
    "name": "小六书旗",
