      "list": "$.data.items[*]",
      "fields": {
        "name": "$.title",
        "author": "$.author",
        "kind": "$.kind",
        "intro": "$.intro",
        "coverUrl": "$.cover",
        "bookUrl": "$.url",
        "type": "= match($.url, '[?&]t=([a-z]+)', 1)"
      }
    },
    "detail": {
      "fields": {
        "name": "$.data.title",
        "author": "$.data.author",
        "kind": "$.data.kind",
        "intro": "$.data.intro",
        "coverUrl": "$.data.cover",
        "tocUrl": "$.data.tocUrl",
        "type": "= match(book.bookUrl, '[?&]t=([a-z]+)', 1)"
      }
    },
    "toc": {
      "list": "$.data.chapters[*]",
      "fields": {
        "title": "$.name",
        "url": "$.url"
      }
    },
    "content": {
      "let": {
        "bookId": "= match(book.bookUrl, '[?&]id=(\\d+)', 1)",
        "chapterId": "= match(urldecode(chapter.url), 'chapterId=(\\d+)', 1)"
      },
      "text": "$.data.content",
      "audio": "$.data.content",
      "video": "$.data.content",
      "comments": {
        "when": "= vars.comments != '关'",
        "stats": {
          "url": "{{source.url}}/api/reader/paragraphs?bookId={{bookId}}&chapterId={{chapterId}}"
        },
        "counts": "= map(stats.data.paragraphs, p => p.commentCount)",
        "paragraphUrl": "{{source.url}}/comment.html?mode=paragraph&bookId={{bookId}}&chapterId={{chapterId}}&paragraphId={{paraId(para.index + 1)}}&paraText={{urlencode(para.text)}}&count={{para.count}}",
        "chapterUrl": "{{source.url}}/comment.html?mode=chapter&bookId={{bookId}}&chapterId={{chapterId}}"
      },
      "links": [
        {
          "label": "本书评论",
          "url": "{{source.url}}/comment.html?mode=book&bookId={{bookId}}"
        }
      ]
    }
  }
]