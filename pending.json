    "group": "渡",
    "comment": "【2026-11-10 检测：TLS 层被拒】DNS 正常（shuqi.neeao.dpdns.org → 104.21.31.178，Cloudflare），但 TLS 握手阶段被 RST，浏览器打开返回 -101。与小六番茄同一作者、同一 DNS 服务，疑为同一原因。\n\n—— 原 comment ——\n请勿用于下载。小说/听书/短剧/漫剧四合一，模式在书源设置或发现页顶部切换；段评与章评入口由应用绘制，可在书源设置里关闭评论。",
    "type": "text",
    "enabled": false,
    "enabledExplore": true,
    "rate": "3",
    "vars": [
      {
        "key": "mode",
        "label": "模式",
        "options": [
          "小说",
          "听书",
          "短剧",
          "漫剧"
        ],
        "default": "小说",
        "filter": true
      },
      {
        "key": "comments",
        "label": "评论",
        "options": [
          "开",
          "关"
        ],
        "default": "开"
      }
    ],
    "let": {
      "m": "= lookup({'小说': 'novel', '听书': 'audio', '短剧': 'drama', '漫剧': 'animated'}, vars.mode, 'novel')"
    },
    "lib": "fn paraId(n) {\n  let digits = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n  let s = ''\n  while (n > 0) {\n    s = substring(digits, n % 36, n % 36 + 1) + s\n    n = int(n / 36)\n  }\n  return 'p' + padStart(s, 3, '0')\n}",
    "search": {
      "url": "{{source.url}}/api/aggregate/search?keyword={{urlencode(key)}}&page={{page}}&mode={{m}}",
      "list": "$.data.items[*]",
      "fields": {
        "name": "$.title",
        "author": "$.author",
        "kind": "$.kind",
        "intro": "$.intro",
        "coverUrl": "$.cover",
        "bookUrl": "$.url",
        "type": "= match($.url, '[?&]t=([a-z]+)', 1)"
      }
    },
