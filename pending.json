    "group": "渡",
    "comment": "【2026-11-10 检测：TLS 层被拒】DNS 正常（fq.neeao.dpdns.org → 104.21.31.178，Cloudflare），但 TLS 握手阶段被 RST，浏览器打开返回 -101。三次尝试结果一致。可能是站点风控或本机 IP 被拦截，需换网络环境复测。\n\n—— 原 comment ——\n由 Legado 兼容格式按《公共书源规则开发文档》迁移而来的原生书源：全部声明式规则，无 JavaScript。模式/频道是发现页顶部筛选项（也可在书源设置修改），听书音色在听书页选择，登录在书源设置里用内置浏览器登录番茄（也可手动填 sessionid）。依赖 fqapi 中转服务，服务器可在书源设置里更换。段评气泡由应用绘制，正文插图保留在行内。短剧/漫剧的视频载荷在 CDN 上是加密的，播放地址优先取接口返回的 video_url_decrypt 解密中转（video_url_proxy 次之，直链 content 仅作兜底）。目录与正文按书籍类型请求对应的内容接口（tab=小说/听书/漫画/短剧/漫剧）。",
    "type": "text",
    "enabled": false,
    "enabledExplore": true,
    "vars": [
      {
        "key": "server",
        "label": "服务器",
        "default": "https://fq.neeao.dpdns.org"
      },
      {
        "key": "mode",
        "label": "模式",
        "options": [
          "小说模式",
          "听书模式",
          "漫画模式",
          "短剧模式",
          "短篇模式",
          "漫剧模式"
        ],
        "default": "小说模式",
        "filter": true
      },
      {
        "key": "channel",
        "label": "频道",
        "options": [
          "男频",
          "女频",
          "出版"
        ],
        "default": "男频",
        "filter": true
      },
      {
        "key": "token",
        "label": "手动登录Token(填sessionid值)",
        "default": ""
      },
      {
        "key": "dp",
        "label": "段评开关(1开/0关)",
        "default": "1"
      },
      {
        "key": "cp",
        "label": "章评开关(1开/0关)",
        "default": "1"
      },
      {
        "key": "bk",
        "label": "书评开关(1开/0关)",
        "default": "1"
      }
    ],
    "lib": "fn tagList(value) {\n  if (typeOf(value) == 'list') { return value }\n  let s = str(value)\n  if (startsWith(s, '[')) {\n    let parsed = json(s)\n    if (typeOf(parsed) == 'list') { return parsed }\n    return []\n  }\n  let out = []\n  for part in split(s, '、') {\n    for piece in split(part, ',') {\n      push(out, piece)\n    }\n  }\n  return out\n}\n\nfn cleanText(s) {\n  let t = replace(s, '<br\\\\s*/?>', '\\n', 'gi')\n  t = replace(t, '</p>', '\\n', 'gi')\n  t = replace(t, '<p[^>]*>', '', 'gi')\n  t = replace(t, '<h[1-6][^>]*>', '\\n', 'gi')\n  t = replace(t, '</h[1-6]>', '\\n', 'gi')\n  t = replace(t, '<div[^>]*>', '\\n', 'gi')\n  t = replace(t, '</div>', '', 'gi')\n  t = replace(t, '<li[^>]*>', '\\n', 'gi')\n  t = replace(t, '</li>', '', 'gi')\n  t = replace(t, '<(?!img\\\\b)[^>]+>', '', 'gi')\n  t = htmlDecode(t)\n  t = replace(t, '\\\\n{3,}', '\\n\\n', 'g')\n  return trim(t)\n}\n\nfn paraCounts(text, paras) {\n  let lines = split(text, '\\n')\n  let out = []\n  let k = 0\n  for line in lines {\n    if (test(line, '<img')) {\n      push(out, 0)\n    } else {\n      push(out, default(paras[str(k)], paras[int(k)], 0))\n      k = k + 1\n    }\n  }\n  return out\n}",
    "login": {
      "url": "https://fanqienovel.com/",
      "cookies": [
        "sessionid"
      ],
      "check": {
        "url": "https://fanqienovel.com/api/user/info/v2",
